{
  // Konfigurasi Cloudflare Workers untuk situs statis.
  //
  // Tidak ada "main" di sini — tanpa skrip Worker, Cloudflare menyajikan
  // isi folder apa adanya sebagai berkas statis. Itu yang kita mau:
  // situs ini HTML dan CSS murni, tidak ada yang perlu dijalankan di server.
  "name": "belmont-web",
  "compatibility_date": "2026-11-22",

  "assets": {
    "directory": "./",

    // "auto-trailing-slash" membuat /panduan/pasang dan
    // /panduan/pasang.html dua-duanya bekerja.
    "html_handling": "auto-trailing-slash",

    // Alamat yang tidak dikenal menampilkan 404.html dengan status 404
    // yang benar.
    //
    // Sebelumnya ini diisi "single-page-application", yang membuat SETIAP
    // alamat ngawur menjawab 200 berisi halaman depan. Enak dilihat, tapi
    // buruk untuk mesin pencari: alamat salah ketik sebanyak apa pun ikut
    // terlihat sah dan terindeks sebagai halaman duplikat.
    "not_found_handling": "404-page"
  }
}
